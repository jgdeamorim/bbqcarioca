{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bbq-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "api.bbqdocarioca.work",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bbq-d1-prod",
      "database_id": "REPLACE_ME_LATER"
    }
  ]
}
