{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bbq-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "api.bbqcarioca.work",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bbq-d1-prod",
      "database_id": "fc9cbef2-ffbb-44ab-8596-359cfa30fbe1"
    }
  ]
}
